#!/bin/bash
# Pre-commit hook to prevent committing sensitive data

echo "Running security checks..."

# Check for sensitive patterns in staged files
SENSITIVE_PATTERNS=(
  "AKIA[0-9A-Z]{16}"                    # AWS Access Key
  "nvapi-[A-Za-z0-9_-]+"                # NVIDIA API Key
  "aws_secret_access_key.*=.*[A-Za-z0-9/+]{40}"  # AWS Secret
  "SECRET_KEY.*=.*[^change-this]"       # Django/FastAPI secret
)

STAGED_FILES=$(git diff --cached --name-only)

for pattern in "${SENSITIVE_PATTERNS[@]}"; do
  if git diff --cached | grep -E "$pattern" > /dev/null; then
    echo "❌ ERROR: Potential secret detected in staged changes!"
    echo "Pattern matched: $pattern"
    echo ""
    echo "Please remove sensitive data before committing."
    echo "If this is a false positive, use: git commit --no-verify"
    exit 1
  fi
done

# Check for sensitive files
SENSITIVE_FILES=(
  ".env"
  "*.tfvars"
  "*accessKeys.csv"
  "*.pem"
  "*.key"
)

for file_pattern in "${SENSITIVE_FILES[@]}"; do
  if echo "$STAGED_FILES" | grep -E "$file_pattern" > /dev/null; then
    echo "❌ ERROR: Attempting to commit sensitive file: $file_pattern"
    echo ""
    echo "This file should be in .gitignore"
    echo "If intentional, use: git commit --no-verify"
    exit 1
  fi
done

echo "✅ Security checks passed"
exit 0
